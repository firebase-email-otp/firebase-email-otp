{
  "name": "firebase-email-otp",
  "version": "2.0.0",
  "description": "Passwordless email authentication for Firebase using secure, one-time verification codes (OTP).",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./shared": {
      "import": {
        "types": "./dist/shared/index.d.ts",
        "default": "./dist/shared/index.js"
      },
      "require": {
        "types": "./dist/shared/index.d.cts",
        "default": "./dist/shared/index.cjs"
      }
    },
    "./functions": {
      "import": {
        "types": "./dist/functions/index.d.cts",
        "default": "./dist/functions/index.cjs"
      },
      "require": {
        "types": "./dist/functions/index.d.cts",
        "default": "./dist/functions/index.cjs"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native/index.d.ts",
        "default": "./dist/react-native/index.js"
      },
      "default": {
        "types": "./dist/react-native/index.d.ts",
        "default": "./dist/react-native/index.js"
      }
    },
    "./react-native/ui": {
      "import": {
        "types": "./dist/react-native/ui/index.d.ts",
        "default": "./dist/react-native/ui/index.js"
      },
      "default": {
        "types": "./dist/react-native/ui/index.d.ts",
        "default": "./dist/react-native/ui/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firebase-email-otp/firebase-email-otp.git"
  },
  "homepage": "https://github.com/firebase-email-otp/firebase-email-otp#readme",
  "bugs": {
    "url": "https://github.com/firebase-email-otp/firebase-email-otp/issues"
  },
  "keywords": [
    "firebase",
    "firebase-auth",
    "firebase-functions",
    "cloud-functions",
    "firestore",
    "email-otp",
    "otp",
    "one-time-password",
    "passwordless",
    "authentication",
    "custom-token",
    "react-native",
    "react-native-firebase",
    "expo"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.functions.json && tsc --noEmit -p tsconfig.react-native.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/auth": "^27.1.0",
    "@react-native-firebase/functions": "^27.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.3.1",
    "eslint": "^9.30.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "^1.23.0",
    "react-test-renderer": "19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@react-native-firebase/app": ">=17",
    "@react-native-firebase/auth": ">=17",
    "@react-native-firebase/functions": ">=17",
    "firebase-admin": ">=11",
    "firebase-functions": ">=4",
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-keyboard-controller": ">=1"
  },
  "peerDependenciesMeta": {
    "@react-native-firebase/app": {
      "optional": true
    },
    "@react-native-firebase/auth": {
      "optional": true
    },
    "@react-native-firebase/functions": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "firebase-functions": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-keyboard-controller": {
      "optional": true
    }
  }
}
